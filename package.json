{
  "name": "academic-os",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "dist:dir": "npm run build && electron-builder -w dir",
    "electron:dev": "npm run build && electron .",
    "dist:portable": "npm run build && electron-builder -w portable"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "dexie": "^4.3.0",
    "framer-motion": "^12.35.0",
    "mammoth": "^1.11.0",
    "pdfjs-dist": "^5.5.207",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.27",
    "electron": "^40.8.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.8",
    "vite": "^7.3.1"
  },
  "build": {
    "appId": "com.academicos.app",
    "productName": "AcademicOS",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "dir",
      "icon": "build/icon.ico"
    }
  }
}
